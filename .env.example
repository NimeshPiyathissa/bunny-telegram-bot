# ==============================================================================
# BUNNY STREAM TELEGRAM DOWNLOADER BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Authentication (MANDATORY)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjkl...)
BOT_TOKEN=

# Get your API ID and API Hash from https://my.telegram.org
API_ID=
API_HASH=

# ------------------------------------------------------------------------------
# 2. Access Control & Admin IDs (MANDATORY)
# ------------------------------------------------------------------------------
# Primary owner Telegram numeric ID (get via @userinfobot)
OWNER_ID=

# Optional: Comma-separated secondary admin Telegram numeric IDs (e.g. 12345,67890)
ADMIN_IDS=

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ------------------------------------------------------------------------------
# 4. Concurrency & Limits
# ------------------------------------------------------------------------------
# Maximum simultaneous download worker processes (recommended: 2 - 4)
MAX_CONCURRENT_DOWNLOADS=2

# Maximum active concurrent download jobs per individual user
MAX_DOWNLOADS_PER_USER=1

# Maximum file size allowed for upload in MB (Telegram default maximum: 1900 MB)
MAX_FILE_SIZE_MB=1900

# Download and upload timeouts in seconds
DOWNLOAD_TIMEOUT_SECONDS=3600
UPLOAD_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# 5. Storage Management & Cleanup Lifecycle
# ------------------------------------------------------------------------------
# Enable background scheduled cleanup service
AUTO_CLEANUP=true

# Delete local MP4, thumbnails, segments, and temp workspace immediately after successful upload
CLEANUP_AFTER_UPLOAD=true

# Hours to retain failed or uncompleted download workspaces for inspection/recovery
FAILED_JOB_RETENTION_HOURS=24

# Hours to retain abandoned temporary files before automatic garbage collection
TEMP_FILE_RETENTION_HOURS=6

# Minimum free disk space in GB required before rejecting new download jobs
MIN_FREE_DISK_GB=3

# ------------------------------------------------------------------------------
# 6. Directories
# ------------------------------------------------------------------------------
DOWNLOAD_DIRECTORY=./downloads
TEMP_DIRECTORY=./temp
LOG_DIRECTORY=./logs
DATA_DIRECTORY=./data
BACKUP_DIRECTORY=./backups

# ------------------------------------------------------------------------------
# 7. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Log level verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 8. Optional: Extended User Session (For 2GB-4GB uploads with Telegram Premium)
# ------------------------------------------------------------------------------
ENABLE_USER_SESSION=false
SESSION_STRING=
